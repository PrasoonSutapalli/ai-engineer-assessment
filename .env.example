# Environment Configuration Template
# Copy this file to .env and insert your API keys if you wish to run with live external LLM/ASR providers.
# The system operates out-of-the-box in standalone production-emulation mode with zero external dependencies required.

# LLM Providers (Optional for live dynamic generation)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Voice / ASR / TTS Providers (Optional for live telephony)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Application Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
EMBEDDING_MODEL=semantic_tfidf_dense
CONFIDENCE_THRESHOLD=0.75
COOLDOWN_SECONDS=45
